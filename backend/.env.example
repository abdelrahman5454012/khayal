# Server
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/khayal

# Redis
REDIS_URL=redis://localhost:6379

# JWT — must be 32+ characters
JWT_SECRET=change_this_to_a_long_random_secret_string_32chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_string

# Bcrypt
BCRYPT_ROUNDS=10

# Akedly SMS — https://akedly.io/
# Get credentials from: app.akedly.io/dashboard → API Keys
AKEDLY_API_URL=https://api.akedly.io/v1/sms/send
AKEDLY_API_KEY=your_akedly_api_key
AKEDLY_SENDER=Khayal

# SMS Provider — use 'mock' during development (logs to console)
SMS_PROVIDER=mock
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM=+1XXXXXXXXXX
